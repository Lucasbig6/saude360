# Copie para .env e preencha. Nunca commite o .env (gitignored).
# ATENÇÃO: SUPERSET_PASSWORD deve ser igual à senha do admin no Superset.
# O seed demo (superset/seed_demo.py) cria admin/admin por padrão; o
# docker-compose de dev usa admin123 — mantenha os dois alinhados.
SUPERSET_BASE_URL=http://localhost:8088
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin123
# Troque em produção: deve ter >=32 chars e ser igual em backend + superset.
SUPERSET_SECRET_KEY=chave_secreta_monisus_ambiente_dev_123
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DATABASE_URL=postgresql+psycopg://saude360:saude360_password@localhost:5433/saude360
TEST_DATABASE_URL=postgresql+psycopg://saude360:saude360_password@localhost:5433/saude360_test

# --- IA (camada app/ai) ---
# Provedor: "openai" (API compatível: OpenAI/Groq/OpenRouter/Ollama/vLLM) ou "sesapi".
# Groq = provider "openai" + AI_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER=openai
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=gsk_SUA_CHAVE_AQUI
AI_TIMEOUT=60
AI_MAX_STEPS=8
AI_MAX_ROWS=500
AI_TOOL_TIMEOUT=60
# false (padrão): auditoria guarda apenas o hash do SQL.
AI_AUDIT_STORE_SQL=false
